/**==================================================================================================================
 **【文件名称】  main.c
 **【功能测试】  LCD_1.8寸屏_STM7735_8针
 **==================================================================================================================
 **【实验平台】  STM32F407 + KEIL5.31 + 1.8寸ST7735显示屏
 **
 **【实验操作】  1_接线
 **                      GND   ---  GND
 **                      VCC   ---  3.3V; 注意, 切勿接5V, 可能产生莫名错误
 **                      SCK   ---  PA5 ; SPI_SCK
 **                      MOSI  ---  PA7 ; SPI_MOSI
 **                      RST   ---  RST ; 低电平复位线；直怼3.3V, 省一个芯片引脚
 **                      DC/RS ---  PA12; 命令、数据切换
 **                      CS    ---  PA8 ; SPI_CS
 **                      BL    ---  PA15;背光控制，高电平亮。魔女科技的1.8寸屏已作优化，内部背光带下拉电阻，默认为熄屏状态，减少误动作亮屏
 **              2_工程编译后，烧录代码到开发板
 **              3_打开串口上位机即可观察数据输出，及显示屏输出
 **
 **【划 重 点】  1-本示例代码，适配市面大部分1.8寸ST7735的4针屏
 **              2_本示例代码，使用硬件SPI，与市面1.8屏常用模拟SPI代码有区别，移植使用时注意和主程序的配合。
 **              3_本示例代码，中文输出使用了两种字模存储方式，注意区别;
 **
 **【备注说明】  版权归魔女科技所有，请勿商用，谢谢！
 **              https://demoboard.taobao.com
====================================================================================================================*/
#include "stm32f4xx.h"
#include "bsp_led.h"
#include "bsp_UART.h"
#include "bsp_LCD_ST7735.h"



/******************************************************************************
 * 函  数： delay_ms
 * 功  能： ms 延时函数
 * 备  注： 1、系统时钟168MHz
 *          2、打勾：Options/ c++ / One ELF Section per Function
            3、编译优化级别：Level 3(-O3)
 * 参  数： uint32_t  ms  毫秒值
 * 返回值： 无
 ******************************************************************************/
static volatile uint32_t ulTimesMS;    // 使用volatile声明，防止变量被编译器优化
static void delay_ms(uint16_t ms)
{
    ulTimesMS = ms * 16500;
    while (ulTimesMS)
        ulTimesMS--;                   // 操作外部变量，防止空循环被编译器优化掉
}
                                              
                                                       
                                                       
                                                       
int main(void)                                         
{                                                      
    NVIC_PriorityGroupConfig(NVIC_PriorityGroup_2);      // 设置系统中断优先级分组2
                                                        
    UART1_Init(115200);                                  // UART1 初始化，用于与串口软件通信; TX-PA9、RX-PA10, 115200-8-N-1，中断发送、接收
                                                        
    Led_Init();                                          // LED 初始化
                                                        
    //W25Q128_Init ();                                   // 【核心板适配】无外部Flash；它还会改写SPI1时序，影响LCD
                     
    LCD_Init();                                          // OLED 初始化; 引脚的修改在bsp_OLED.h中
    LCD_Fill (0,0,128,160,WHITE);                        // 整个背景填充白色
                                                         
    // 图片显示示范                                    
    // extern const unsigned char bmp_128_128[32768];     /* 【核心板适配】该数组占32KB，是超限主因；官方注释亦称"太吃资源了" */
    // LCD_Image(0,  32,  128, 128, bmp_128_128);         /* 【核心板适配】移除32KB图片，MDK-Lite评估版限32KB，装不下 */
                                                       
    // 文本显示示范_方式1                                // 使用存储在font.h文件中的汉字字模数据; 这种方式，适合没有Flash字库且要显示少量汉字的方案; 前提条件：需要提示自行制作汉字字模数据，然后存储于代码数组中;     
    LCD_ShowChinese( 20,5,0,16, WHITE , BLACK);          // 温, 在字模数组中的第0个字模      
    LCD_ShowChinese( 38,5,1,16, WHITE, BLACK);           // 湿, 在字模数组中的第1个字模
    LCD_ShowChinese( 56,5,2,16, WHITE, BLACK);           // 度, 在字模数组中的第2个字模
    LCD_ShowChinese( 74,5,3,16, WHITE, BLACK);           // 采, 在字模数组中的第3个字模
    LCD_ShowChinese( 92,5,4,16, WHITE, BLACK);           // 集, 在字模数组中的第4个字模
    
    // 画线示范
    LCD_Line(0,24,128,24, GRAY);                         // 画个横线
    LCD_Line(0,25,128,25, GRAY);                         // 再画个横线，意思就是加粗一下
                                                        
    // 文本显示示范_方式2                                // 使用板上Flash中的汉字字模，发货前已烧录好四种大小字模：12号、16号、24号、32号
    static char strTemp[30];                            
    LCD_ShowChinese( 5,34,0,16, GRAY , YELLOW);          // 【核心板适配】温
    LCD_ShowChinese(21,34,1,16, GRAY , YELLOW);          // 度         // 本函数，可显示中英文字符串; 函数内自动选择font.h中的ASCII字模、Flash中的汉字字模; Flash中已存在放较为完成的汉字字模数据，四字字号，12号、16号、24号、32号，约6M大小
    float temperature = 18.5;                            // 假设已采集的温度。用于展示如何显示小数等数据;
    sprintf(strTemp, "%2.1f℃", temperature);            // 重要：很多人咨询, 如何把各种数据类型，转换为字符串，再显示到显示屏: sprintf函数有神效，请自行百度用法;
    LCD_String(54, 34, strTemp, 16, YELLOW, GRAY);       // 显示数值到显示屏上                                             
                                                        
    LCD_ShowChinese( 5,56,2,16, GRAY , YELLOW);          // 【核心板适配】湿
    LCD_ShowChinese(21,56,3,16, GRAY , YELLOW);          // 度                      
    float humidity = 85.3;                               // 假设已采集的温度。用于展示如何显示小数等数据;
    sprintf(strTemp, "%2.1f %%", humidity);              // 重要：很多人咨询, 如何把各种数据类型，转换为字符串，再显示到显示屏: sprintf函数有神效，请自行百度用法;
    LCD_String(54, 56, strTemp, 16, YELLOW, GRAY);       // 显示数值到显示屏上 
            
                                                       
    while (1)                                            // while函数死循环，不能让main函数运行结束，否则会产生硬件错误
    {                                                   
        delay_ms(500);                                   // 间隔延时
        LED_BLUE_TOGGLE ;                                // 规律地闪烁LED，方便外部观察系统是否正在运行
    }
}


// 每个代码文件的末尾，注意要加两个空行

