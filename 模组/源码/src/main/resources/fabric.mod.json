{
  "schemaVersion": 1,
  "id": "mcserial",
  "version": "${version}",
  "name": "MC Serial Bridge",
  "description": "把 Minecraft 玩家状态通过串口发送给 F407 半身像显示器。走动/受伤/跳跃/攻击/睡觉都会实时反映。",
  "authors": ["monv"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["com.monv.mcserial.McSerialClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~1.21.8",
    "java": ">=21",
    "fabric-api": "*"
  }
}
